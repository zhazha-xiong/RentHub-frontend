# ============================================================
# RentHub-frontend
#   web/                新前端（Vite + TS + Ant Design Vue 4）
#   legacy/v1-spa/      第一版 SPA 原型（美术/交互参照）
#   legacy/v2-static/   最早的静态站（美术参照）
#   docs/               设计评审、索引方案、契约补充说明
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnp
.pnp.js
.yarn/
.yarnrc.yml

# ---------- 构建与测试产物 ----------
dist/
dist-ssr/
build/
.output/
.vite/
.parcel-cache/
coverage/
test-results/
playwright-report/
blob-report/
*.local

# ---------- 日志 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 运行态数据（旧版服务的会话/收藏/订单/草稿、高德缓存） ----------
runtime/
cache/
web/mock/.data/

# ---------- 包管理器缓存 ----------
.npm-cache/
.pnpm-store/
.eslintcache
.stylelintcache

# ---------- 环境变量与密钥 ----------
.env
.env.*
!.env.example
config.local.json
config.server.local.json
# 导出的 GitHub PAT / 各种临时令牌一律不要进仓库
token.txt
*.pat
secrets*.txt
secrets*.json

# ---------- TS 增量 / E2E 登录态 ----------
*.tsbuildinfo
web/e2e/.auth/

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
