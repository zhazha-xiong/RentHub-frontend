{
  "name": "renthub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "栖居 RentHub 新前端（Vue 3.5 + Vite 5 + Pinia 2 + Vue Router 4 + Ant Design Vue 4 + Axios 1.7）",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "pinia": "^2.3.1",
    "vue": "^3.5.45",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
